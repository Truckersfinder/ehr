# App server (local development uses port 3000 by default; `npm run dev` sets PORT=3000)
PORT=3000

# Bind address: default 127.0.0.1 (only this machine). Set to 0.0.0.0 for VM/LAN/public IP access.
# HOST=0.0.0.0

# Optional: VPS password for scripts/ssh-imani.sh (prefer SSH keys; never commit real values).
# SERVER_PASSWORD=

# If the UI runs on Vite’s port (5173), the client forwards /api to this origin (see client/src/lib/dev-api-fetch.ts)
# VITE_API_ORIGIN=http://127.0.0.1:3000

# PostgreSQL connection string (Drizzle reads this; local dev uses dotenv).
# To copy this value to the VPS .env on deploy: IMANI_SYNC_DATABASE_URL=1 ./scripts/deploy-imani.sh
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ehr

# JWT signing (staff login + patient portal). Set a long random value in production.
# SESSION_SECRET=...

# External REST API (`/api/v1`): OAuth2 access tokens issued from `/api/v1/oauth/token` are signed with this secret.
# Defaults to SESSION_SECRET if unset. Use a dedicated secret in production.
# INTEGRATION_JWT_SECRET=...

# Integration rate limit (requests per minute, per API key)
# INTEGRATION_RATE_LIMIT_PER_MIN=120

# Outbound webhook HTTP timeout (ms) for `/api/v1` event delivery
# INTEGRATION_WEBHOOK_TIMEOUT_MS=15000

# Optional: restrict webhook destinations (comma-separated hostnames). Example:
# INTEGRATION_WEBHOOK_ALLOWED_HOSTS=partner.example.com,webhooks.vendor.com

# Optional: Redis for persisted integration rate limiting (recommended in production)
# REDIS_URL=redis://localhost:6379

# Integration idempotency retention / size caps
# INTEGRATION_IDEMPOTENCY_TTL_DAYS=7
# INTEGRATION_IDEMPOTENCY_MAX_BYTES=50000

# Resend — patient portal invitation emails (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# "From" address — must match a domain that shows "Verified" in https://resend.com/domains (not just "added").
# If Resend says "domain is not verified", finish DNS records at your registrar and wait; or use onboarding@resend.dev for tests.
# Until a domain is verified, Resend may only deliver to your account email. For local testing you can use that as the patient email.
# RESEND_FROM_EMAIL=noreply@your-verified-domain.com
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Behind Nginx + TLS (production). After provision-imani-https.sh:
# TRUST_PROXY=1
# PATIENT_PORTAL_BASE_URL=https://imaniehr.com
# PUBLIC_APP_URL=https://imaniehr.com
# HOST=127.0.0.1

# DNS: point imaniehr.com (and www if used) A/CNAME to your VPS; open ports 80 & 443.

# Fallback display name for public portal branding only when no active facility has a name in Admin (does not override the organization name set by the systems administrator).
# HOSPITAL_DISPLAY_NAME=Imani
